# ─────────────────────────────────────────────────────────────────────────────
# chat-server 配置示例
#
# 用法：
#   cp .env.example .env && 按需填写
#   set -a && . ./.env && set +a && ./chat-server
#
# 或者交给 systemd：把本文件拷成 /etc/chat-server.env（chmod 600），
# 在 chat-server.service 里用 EnvironmentFile=/etc/chat-server.env 加载。
#
# 只有 DS_API_KEY 是必填项，其余全部有可用默认值。
# 完整说明见 docs/configuration.md。
# ─────────────────────────────────────────────────────────────────────────────

# ── 上游 DeepSeek API（必填） ────────────────────────────────────────────────
DS_API_KEY=
DS_API_BASE=https://api.deepseek.com
DS_MODEL=deepseek-flash
# 前端不发 max_tokens 时服务端补的默认值；调小可省钱，调大要防截断
CHAT_MAX_TOKENS=8192
# 单次上游请求超时（秒）
CHAT_UPSTREAM_TIMEOUT=300

# ── 监听与存储 ───────────────────────────────────────────────────────────────
CHAT_BIND=127.0.0.1
CHAT_PORT=8083
CHAT_DB=/var/lib/chat-server/chat.db
# 附件目录默认取 CHAT_DB 同级的 files/，一般不用改
# 上传的分享页 HTML 落盘目录
CHAT_SHARE_DIR=/opt/chatweb/share
# 分享链接前缀与站点地址（分享页里的品牌链接）；部署域名不是 chat.example.com 时必须改
CHAT_SHARE_BASE=https://chat.example.com/share/
CHAT_WEB_BASE=https://chat.example.com

# ── 鉴权 ─────────────────────────────────────────────────────────────────────
# 留空 = 允许匿名（按 UA+IP 派生用户，适合个人自用）；
# 内网暴露/多人使用时应关掉，走账号体系或固定令牌。
CHAT_ALLOW_ANON=1
# 全局固定令牌：填了它，任何带这个令牌的请求都算同一个用户（慎用）
CHAT_TOKEN=
# 后台管理令牌：留空 = 后台整体关闭；设置后访问 /admin/ 需要 Bearer 这个值
CHAT_ADMIN_TOKEN=

# ── 注册 / 验证码邮件（可选，不配则注册接口不可用） ─────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=465
# implicit(465) | starttls(587) | none(25)
SMTP_TLS=implicit
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=SelfDeepSeek | SDS

# ── OIDC 登录（可选，与「邮箱+密码」并存） ──────────────────────────────────
# 以自建 TinyAuth 为例；用任何 OIDC 提供方都行
TINYAUTH_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=chat
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_REDIRECT=https://api.example.com/auth/v1/auth/oidc/callback

# ── 上下文压缩（长对话） ────────────────────────────────────────────────────
# 估算 token 超过「窗口 × 比例」时，把早期消息折叠成摘要再发给上游
CHAT_CONTEXT_WINDOW=1048576
CHAT_COMPACT_RATIO=0.8
# 直接指定阈值则优先生效（留空 = 用窗口 × 比例）
CHAT_COMPACT_THRESHOLD=
# 压缩后保留最近多少条原文
CHAT_COMPACT_KEEP=8
CHAT_COMPACT_MODEL=

# ── 跨会话记忆（用户画像 + 历史检索） ───────────────────────────────────────
CHAT_PROFILE_AUTO_SUMMARIZE=1
CHAT_PROFILE_MODEL=
# 画像字数上限，超了先让模型压缩，压不下来才截断
CHAT_PROFILE_MAX_CHARS=3000
# 一次调用能塞进多少 token 的会话全文（超出则分段提炼再汇总）
CHAT_PROFILE_CONTEXT_TOKENS=700000
# 手动重建画像时取最近多少段会话
CHAT_PROFILE_REBUILD_LIMIT=50
# 总结/压缩的输入截断上限（字符）
CHAT_SUMMARY_MAX_INPUT=24000

# ── run_rhai 沙箱脚本工具 ───────────────────────────────────────────────────
# 0 = 不下发该工具
CHAT_RHAI_ENABLE=1
CHAT_RHAI_BIN=/opt/chat-server/rhai-runner

# ── 调试：把上游原始事件落盘（排查用，平时别开） ────────────────────────────
CHAT_TRACE_DIR=
CHAT_TRACE_ALL=
